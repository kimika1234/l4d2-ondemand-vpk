# on-demand VPK 控制器/回收器配置模板（v2.0）
# 复制为 /opt/ondemand/ondemand.env，然后 chmod 600
# 控制器和回收器跑在【目标服务器】上（Docker 服跑宿主机，裸机服直接跑），零依赖（只要 python3）

# ─── 游戏根目录 ───
# Docker 服：填宿主机上挂载进容器的游戏根（如 /shared/left4dead2）
# 裸机服：填 srcds 所在 left4dead2 目录（如 /home/steam/left4dead2）
ONDEMAND_GAME_ROOT=/shared/left4dead2

# ─── RCON ───
# 游戏服 RCON 密码（server.cfg 里 rcon_password 的值）
ONDEMAND_RCON_PASSWORD=CHANGE_ME

# ─── 游戏服端口列表（逗号分隔）───
# 单服：填这一个服的端口即可，如 ONDEMAND_SERVERS=27015
# 多服共享 addons：填所有服端口，如 ONDEMAND_SERVERS=27015,27016,27017
# 控制器/回收器会连 127.0.0.1:<端口> 执行 RCON（Docker 服要求端口映射到宿主 127.0.0.1）
ONDEMAND_SERVERS=27015

# ─── 轮询间隔（秒）───
ONDEMAND_POLL=2

# ─── 目录（相对游戏根，一般不用改）───
ONDEMAND_REQ_DIR=addons/sourcemod/data/ondemand_vpk_requests
ONDEMAND_LIB_DIR=map_library
ONDEMAND_ADDONS_DIR=addons
ONDEMAND_CFG=addons/sourcemod/configs/ondemand_vpk.cfg

# ─── 白名单战役（逗号分隔，空 = 全部）───
ONDEMAND_CAMPAIGNS=

# ─── 回收器：连续 N 次检查才动手（一般不用改）───
ONDEMAND_ZERO_REQUIRED=2